{
  "name": "filebrowser-frontend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "setup:pnpm": "node scripts/bootstrap-pnpm.mjs",
    "dev": "vite dev",
    "build": "pnpm run typecheck && vite build",
    "clean": "find ./dist -maxdepth 1 -mindepth 1 ! -name '.gitkeep' -exec rm -r {} +",
    "typecheck": "vue-tsc -p ./tsconfig.app.json --noEmit && tsc -p ./tsconfig.node.json --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write .",
    "test": "vitest run src/",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "ace-builds": "^1.45.2",
    "csv-parse": "^7.0.3",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.18",
    "epubjs": "^0.3.93",
    "filesize": "^11.0.33",
    "jwt-decode": "^4.0.0",
    "katex": "^0.18.10",
    "lodash-es": "^4.18.1",
    "marked": "^18.2.1",
    "marked-katex-extension": "^5.1.13",
    "material-icons": "^1.13.14",
    "normalize.css": "^8.0.1",
    "pinia": "^4.1.0",
    "qrcode.vue": "^3.11.0",
    "tus-js-client": "^4.3.1",
    "utif": "^3.1.0",
    "video.js": "^8.24.2",
    "videojs-hotkeys": "^0.2.30",
    "videojs-mobile-ui": "^1.3.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-reader": "^1.3.9",
    "vue-router": "^5.5.1",
    "vue-toastification": "2.0.0-rc.5"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@playwright/test": "^1.65.1",
    "@tsconfig/node26": "^26.0.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-compression2": "^2.5.4",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "pnpm": {
    "overrides": {
      "katex": "^0.18.2",
      "rollup": "^4.68.4",
      "esbuild": "^0.28.2",
      "@xmldom/xmldom": "0.8.15"
    }
  }
}
