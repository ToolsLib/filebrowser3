# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM --platform=$BUILDPLATFORM node:26.13.1-alpine3.23@sha256:39d8c143e60e99ae98f014bebea1e72fc96d3c9bdf9504bc3a27af5c05bfa39f AS assets
WORKDIR /app
ENV COREPACK_HOME=/var/cache/corepack
RUN corepack enable
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN --mount=type=cache,id=filebrowser-next-corepack,target=/var/cache/corepack,sharing=locked \
    --mount=type=cache,id=filebrowser-next-pnpm,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --store-dir=/pnpm/store --package-import-method=copy
# Only files that affect the production bundle belong in this stage.
COPY frontend/env.d.ts frontend/tsconfig*.json frontend/vite.config.ts frontend/postcss.config.cjs ./
COPY frontend/src/ ./src/
COPY frontend/public/ ./public/
RUN --mount=type=cache,id=filebrowser-next-corepack,target=/var/cache/corepack,sharing=locked pnpm build

FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine3.23@sha256:f70850ef6ce341e8b6427f677049145d63c0b7ce002d4d7e3d464828b1b96dcd AS backend
WORKDIR /src
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY --exclude=frontend --exclude=docker . .
COPY frontend/*.go ./frontend/
COPY --from=assets /app/dist ./frontend/dist
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=0.0.0-dev
ARG VCS_REF=unknown
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -o /tmp/filebrowser-build ./tools/build && \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} /tmp/filebrowser-build -o /filebrowser -version "${VERSION}" -commit "${VCS_REF}"

FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
ARG VERSION=0.0.0-dev
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="File Browser 3" \
      org.opencontainers.image.source="https://github.com/ToolsLib/filebrowser3" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}"
RUN apk add --no-cache ca-certificates && addgroup -g 1000 app && adduser -D -u 1000 -G app app && mkdir -p /srv /database /config /cache && chown app:app /srv /database /config /cache
COPY --from=backend /filebrowser /usr/local/bin/filebrowser
COPY LICENSE NOTICE /usr/share/licenses/filebrowser3/
COPY --chmod=0555 docker/local/filebrowser-entrypoint.sh /usr/local/bin/filebrowser-entrypoint
USER 1000:1000
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=15s CMD wget -q --spider http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["/usr/local/bin/filebrowser-entrypoint"]
